    "dotenv": "^17.4.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sanity": "^5.31.1",
    "slugify": "^1.6.9",
    "styled-components": "^6.3.12"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.14",
    "concurrently": "^10.0.5",
