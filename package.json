    "build:studio": "sanity build",
    "build:all": "sanity build && cd web && pnpm build",
    "start": "cd web && pnpm start",
    "start:web": "cd web && pnpm start",
    "start:studio": "sanity start",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy"
