  "scripts": {
    "dev": "concurrently -n \"studio,web\" -c \"magenta,blue\" \"sanity dev\" \"cd web && pnpm dev\"",
    "dev:studio": "sanity dev",
    "dev:web": "cd web && pnpm dev",
    "build": "cd web && pnpm build",
